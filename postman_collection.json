{
  "info": {
    "name": "VyaaparSahayak API",
    "description": "SaaS Platform for Startup Management & Growth",
    "version": "1.0.0",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "System",
      "item": [
        {
          "name": "Root Status",
          "request": {
            "method": "GET",
            "url": "http://127.0.0.1:8001/",
            "description": "Check backend is running"
          }
        },
        {
          "name": "Favicon",
          "request": {
            "method": "GET",
            "url": "http://127.0.0.1:8001/favicon.ico"
          }
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "Create Product",
          "request": {
            "method": "POST",
            "url": "http://127.0.0.1:8001/products",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Laptop Bag\",\n  \"cost_price\": 500,\n  \"selling_price\": 1500,\n  \"inventory\": 50,\n  \"category\": \"Accessories\",\n  \"units_per_batch\": 25,\n  \"production_cost\": 10000,\n  \"production_time\": 3.5\n}"
            }
          }
        },
        {
          "name": "List Products",
          "request": {
            "method": "GET",
            "url": "http://127.0.0.1:8001/products",
            "description": "Get all products"
          }
        },
        {
          "name": "Product Performance",
          "request": {
            "method": "GET",
            "url": "http://127.0.0.1:8001/products/1/performance",
            "description": "Get performance metrics for a product"
          }
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "Create Order",
          "request": {
            "method": "POST",
            "url": "http://127.0.0.1:8001/orders",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"product_id\": 1,\n  \"channel\": \"amazon\",\n  \"quantity\": 5,\n  \"customer_ref\": \"CUST-001\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Dashboard",
      "item": [
        {
          "name": "Dashboard Summary",
          "request": {
            "method": "GET",
            "url": "http://127.0.0.1:8001/dashboard",
            "description": "Overview: revenue, profit, orders, best/worst products"
          }
        },
        {
          "name": "Channel-wise Breakdown",
          "request": {
            "method": "GET",
            "url": "http://127.0.0.1:8001/dashboard/channel-wise",
            "description": "Revenue and orders by sales channel"
          }
        },
        {
          "name": "Product-wise Stats",
          "request": {
            "method": "GET",
            "url": "http://127.0.0.1:8001/dashboard/products",
            "description": "Per-product metrics: revenue, profit, velocity, inventory"
          }
        },
        {
          "name": "Sales Summary",
          "request": {
            "method": "GET",
            "url": "http://127.0.0.1:8001/dashboard/sales-summary",
            "description": "Profit margin, avg order value, inventory health"
          }
        }
      ]
    },
    {
      "name": "Production",
      "item": [
        {
          "name": "Record Production Batch",
          "request": {
            "method": "POST",
            "url": "http://127.0.0.1:8001/products/1/production_batches",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"units_produced\": 50,\n  \"production_cost\": 8000,\n  \"production_time\": 2.5,\n  \"date\": \"2024-12-19\"\n}"
            }
          }
        },
        {
          "name": "Production Insights",
          "request": {
            "method": "GET",
            "url": "http://127.0.0.1:8001/products/1/production_insights",
            "description": "Cost per unit, leakage detection, margin impact"
          }
        }
      ]
    },
    {
      "name": "Schemes",
      "item": [
        {
          "name": "List Schemes",
          "request": {
            "method": "GET",
            "url": "http://127.0.0.1:8001/schemes",
            "description": "List all government schemes"
          }
        },
        {
          "name": "Create Startup Profile",
          "request": {
            "method": "POST",
            "url": "http://127.0.0.1:8001/startup-profile",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"business_name\": \"Tech Innovations Ltd\",\n  \"business_type\": \"manufacturing\",\n  \"industry\": \"electronics\",\n  \"location\": \"Bangalore\",\n  \"growth_stage\": \"early\",\n  \"msme_registered\": false,\n  \"annual_revenue\": 5000000\n}"
            }
          }
        },
        {
          "name": "Matched Schemes",
          "request": {
            "method": "GET",
            "url": "http://127.0.0.1:8001/startup-profile/1/matched-schemes",
            "description": "Get schemes matching startup profile"
          }
        }
      ]
    },
    {
      "name": "Risk & AI",
      "item": [
        {
          "name": "Analyze Risks (AI Action Plan)",
          "request": {
            "method": "POST",
            "url": "http://127.0.0.1:8001/risk-analysis",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"startup_profile_id\": 1,\n  \"openai_api_key\": \"sk-your-key-here\"\n}"
            },
            "description": "Detect risks + get AI-generated action plan (requires OpenAI API key)"
          }
        },
        {
          "name": "Get Risk Report",
          "request": {
            "method": "GET",
            "url": "http://127.0.0.1:8001/risk-analysis/1",
            "description": "Retrieve stored risk analysis report"
          }
        }
      ]
    }
  ]
}
